APP_NAME="MAUZO FASTA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=http://app.mauzofasta.local
APP_LOCALE=sw
APP_FALLBACK_LOCALE=en

MARKETING_URL=http://mauzofasta.local

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mauzofasta
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@mauzofasta.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Business onboarding / platform defaults (Super Admin can override at runtime via system_settings)
TRIAL_DAYS=30

# WhatsApp integration — provider-independent (see App\Services\WhatsApp\WhatsAppServiceInterface)
# Leave WHATSAPP_PROVIDER empty to use the log-only/no-op implementation during local development.
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# AI assistant — provider-independent (see App\Services\Ai\AiServiceInterface)
# Leave AI_PROVIDER empty to disable the "Muulize MAUZO FASTA" feature entirely.
AI_PROVIDER=
AI_API_KEY=

VITE_APP_NAME="${APP_NAME}"
